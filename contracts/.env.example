# Copy to .env (git-ignored). Fill PRIVATE_KEY with `node ../scripts/new-wallet.mjs`, never by hand-pasting.
PRIVATE_KEY=
DEPLOYER_ADDRESS=

# Public RPCs (override with your own if rate-limited)
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC=https://sepolia.base.org
UNICHAIN_SEPOLIA_RPC=https://sepolia.unichain.org

# Optional
# WATCHED_WALLET=0x...        # wallet the autopilot tracks (default: the deployer)
# AUTOPILOT_FUNDING=2000000000000000000   # lREACT sent to the reactive contract at deploy
# CALLBACK_FUNDING=10000000000000000      # testnet ETH sent to each callback contract
# SNAPSHOT_INTERVAL=14400                 # seconds between journal snapshots
